# =============================================================================
# ExamPaper Refine - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Google Gemini API Key (required)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Gemini model to use for analysis and rewriting
# Options: gemini-2.0-flash-lite, gemini-2.0-flash, gemini-2.5-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Data directory (where originals, derivatives, and DB are stored)
# Relative to the backend/ directory, or use an absolute path
DATA_DIR=../data

# Maximum upload file size in megabytes
MAX_FILE_SIZE_MB=50

# Maximum pages per document (to prevent abuse)
MAX_PAGES=30

# Server configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration
# Supabase PostgreSQL: paste the connection string from Supabase → Connect.
# Keep the asyncpg driver prefix, for example:
# DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:5432/postgres
# Default (SQLite local): leave empty.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.bkhtnslcoprpblacwkdt.supabase.co:5432/postgres
# Optional pooled connection fallback for machines without direct Supabase
# database DNS/IPv6 access. Leave blank if the direct URL works locally.
SUPABASE_POOLER_HOST=
SUPABASE_PROJECT_REF=

# Redis & Celery Task Queue
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
AUTO_REPROCESS_NEEDS_REVIEW=true

# Rate Limiting
RATE_LIMIT_UPLOAD=5/hour
RATE_LIMIT_GENERAL=60/minute
RATE_LIMIT_REPROCESS=10/hour

# Optional Email Notification (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@exampaper.org
SMTP_TLS=true

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
